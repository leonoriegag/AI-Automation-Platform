# Server Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexora_automation?schema=public"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexora_automation
POSTGRES_PORT=5432

# Security & Cryptography (CRITICAL: Replace with 64-char hex string in production)
# Example generated with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_SECRET=dev-jwt-super-secret-key-change-in-production-min32chars
JWT_EXPIRES_IN=24h

# Background Job Queue (pg-boss)
JOB_QUEUE_SCHEMA=pgboss
JOB_CONCURRENCY=5

# AI Provider Settings (Offline Mock enabled by default)
AI_PROVIDER_DEFAULT=mock
# Optional: Set these if using real live providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=

# Webhook Security
WEBHOOK_DEFAULT_TIMEOUT_MS=10000
WEBHOOK_MAX_BODY_BYTES=1048576

# Email Provider Settings (Mock by default)
EMAIL_PROVIDER_DEFAULT=mock
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@nexora.io

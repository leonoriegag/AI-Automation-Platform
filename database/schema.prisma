datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ORG_ADMIN
  WORKFLOW_EDITOR
  WORKFLOW_OPERATOR
  APPROVER
  VIEWER
}

enum CredentialType {
  BEARER_TOKEN
  API_KEY
  OAUTH2
  BASIC_AUTH
  WEBHOOK_SECRET
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ExecutionStatus {
  PENDING
  RUNNING
  WAITING
  COMPLETED
  FAILED
  CANCELLED
}

enum StepStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum AuditAction {
  WORKFLOW_CREATED
  WORKFLOW_UPDATED
  WORKFLOW_DELETED
  WORKFLOW_ACTIVATED
  WORKFLOW_DEACTIVATED
  WORKFLOW_EXECUTED
  CREDENTIAL_CREATED
  CREDENTIAL_DELETED
  APPROVAL_GRANTED
  APPROVAL_REJECTED
  EXECUTION_CANCELLED
  USER_LOGIN
  SECURITY_POLICY_VIOLATION
}

enum CrmLeadStatus {
  NEW
  QUALIFIED
  DISQUALIFIED
  CONTACTED
  PROPOSAL_SENT
  WON
  LOST
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  slug      String   @unique @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users            User[]
  workflows        Workflow[]
  credentials      Credential[]
  executions       Execution[]
  approvalRequests ApprovalRequest[]
  auditLogs        AuditLog[]
  crmContacts      CrmContact[]
  crmLeads         CrmLead[]
  crmActivities    CrmActivity[]
  mockEmails       MockEmailOutbox[]

  @@map("organizations")
}

model User {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.VarChar(255)
  passwordHash   String       @map("password_hash") @db.VarChar(255)
  name           String       @db.VarChar(100)
  role           Role         @default(VIEWER)
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  auditLogs        AuditLog[]
  approvalRequests ApprovalRequest[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("users")
}

model Credential {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String         @db.VarChar(100)
  type            CredentialType
  encryptedSecret String         @map("encrypted_secret") @db.Text
  maskedHint      String         @map("masked_hint") @db.VarChar(50)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("credentials")
}

model Workflow {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String         @db.VarChar(100)
  description    String?        @db.VarChar(500)
  status         WorkflowStatus @default(DRAFT)
  currentVersion Int            @default(1) @map("current_version")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  versions   WorkflowVersion[]
  executions Execution[]

  @@index([organizationId])
  @@map("workflows")
}

model WorkflowVersion {
  id         String   @id @default(uuid()) @db.Uuid
  workflowId String   @map("workflow_id") @db.Uuid
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  version    Int
  graph      Json
  changelog  String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([workflowId, version])
  @@index([workflowId])
  @@map("workflow_versions")
}

model Execution {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @map("organization_id") @db.Uuid
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workflowId      String          @map("workflow_id") @db.Uuid
  workflow        Workflow        @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  workflowVersion Int             @map("workflow_version")
  status          ExecutionStatus @default(PENDING)
  triggerType     String          @map("trigger_type") @db.VarChar(50)
  triggerPayload  Json?           @map("trigger_payload")
  currentNodeId   String?         @map("current_node_id") @db.VarChar(100)
  context         Json            @default("{}")
  error           String?         @db.Text
  startedAt       DateTime?       @map("started_at")
  completedAt     DateTime?       @map("completed_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  stepExecutions   StepExecution[]
  approvalRequests ApprovalRequest[]

  @@index([organizationId])
  @@index([workflowId])
  @@index([status])
  @@map("executions")
}

model StepExecution {
  id          String     @id @default(uuid()) @db.Uuid
  executionId String     @map("execution_id") @db.Uuid
  execution   Execution  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  nodeId      String     @map("node_id") @db.VarChar(100)
  nodeType    String     @map("node_type") @db.VarChar(100)
  status      StepStatus @default(PENDING)
  input       Json?
  output      Json?
  error       String?    @db.Text
  durationMs  Int?       @map("duration_ms")
  startedAt   DateTime?  @map("started_at")
  completedAt DateTime?  @map("completed_at")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@index([executionId])
  @@index([executionId, nodeId])
  @@map("step_executions")
}

model ApprovalRequest {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @map("organization_id") @db.Uuid
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executionId     String         @map("execution_id") @db.Uuid
  execution       Execution      @relation(fields: [executionId], references: [id], onDelete: Cascade)
  stepExecutionId String         @map("step_execution_id") @db.Uuid
  nodeId          String         @map("node_id") @db.VarChar(100)
  title           String         @db.VarChar(200)
  description     String?        @db.VarChar(1000)
  payload         Json           @default("{}")
  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?        @map("decided_by_user_id") @db.Uuid
  decidedByUser   User?          @relation(fields: [decidedByUserId], references: [id], onDelete: SetNull)
  decisionNotes   String?        @map("decision_notes") @db.VarChar(500)
  decidedAt       DateTime?      @map("decided_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([executionId])
  @@index([status])
  @@map("approval_requests")
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?      @map("user_id") @db.Uuid
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         AuditAction
  resourceType   String       @map("resource_type") @db.VarChar(100)
  resourceId     String?      @map("resource_id") @db.VarChar(100)
  metadata       Json         @default("{}")
  ipAddress      String?      @map("ip_address") @db.VarChar(45)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model CrmContact {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @db.VarChar(255)
  firstName      String       @map("first_name") @db.VarChar(100)
  lastName       String       @map("last_name") @db.VarChar(100)
  company        String?      @db.VarChar(150)
  phone          String?      @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  leads CrmLead[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("crm_contacts")
}

model CrmLead {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contactId      String?       @map("contact_id") @db.Uuid
  contact        CrmContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title          String        @db.VarChar(200)
  status         CrmLeadStatus @default(NEW)
  score          Int           @default(0)
  estimatedValue Float         @default(0) @map("estimated_value")
  assignedTo     String?       @map("assigned_to") @db.VarChar(100)
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("crm_leads")
}

model CrmActivity {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String       @map("entity_type") @db.VarChar(50)
  entityId       String       @map("entity_id") @db.Uuid
  type           String       @db.VarChar(50)
  content        String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([entityId])
  @@map("crm_activities")
}

model MockEmailOutbox {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  to             String       @db.VarChar(255)
  from           String       @db.VarChar(255)
  subject        String       @db.VarChar(255)
  bodyHtml       String       @map("body_html") @db.Text
  status         String       @default("DELIVERED") @db.VarChar(50)
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId])
  @@map("mock_email_outbox")
}
